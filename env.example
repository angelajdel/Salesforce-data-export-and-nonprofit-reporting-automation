# Copy this file to ".env" in the same folder, then fill in your real values.
# Never commit ".env" or paste its contents anywhere -- it stays on your machine only.

# --- Choose ONE auth method ---
SF_AUTH_METHOD=password
# SF_AUTH_METHOD=client_credentials

# --- Option A: password flow ---
SF_USERNAME=you@yourorg.org
SF_PASSWORD=your_salesforce_password
SF_SECURITY_TOKEN=paste_the_token_salesforce_emailed_you
SF_DOMAIN=login
# use SF_DOMAIN=test if this is a Sandbox org

# --- Option B: client credentials flow (uncomment and fill in if using this) ---
# SF_CLIENT_ID=your_connected_apps_consumer_key
# SF_CLIENT_SECRET=your_connected_apps_consumer_secret
# SF_DOMAIN=login

# --- Optional: override the default queries without editing the script ---
# SF_CLIENT_SOQL=SELECT Id, FirstName, LastName, Email FROM Contact WHERE RecordType.Name = 'Client'
# SF_DONOR_SOQL=SELECT Id, Account.Name, Amount, CloseDate FROM Opportunity WHERE IsWon = true
